    {
      "type": "frame",
      "id": "fAE07",
      "x": 277,
      "y": 0,
      "name": "Design Notes — Revised",
      "width": 420,
      "fill": "#2b2b2b",
      "cornerRadius": 8,
      "layout": "vertical",
      "gap": 14,
      "padding": 20,
      "children": [
        {
          "type": "text",
          "id": "h5Kf89",
          "fill": "#ffffff",
          "content": "COLMAP Export Tab — Revised Design",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "bold"
        },
        {
          "type": "frame",
          "id": "uLt7I",
          "name": "c1",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "nygRd",
              "fill": "#16a34a",
              "content": "1. Three sensor categories",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "SX9Xb",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Fisheye (equisolid + equidistant), Frame, and Equirectangular. Each gets its own section with type-specific options. All auto-detected from cameras.xml sensor type + calibration type.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "LAitm",
          "name": "c2",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "L1fp0g",
              "fill": "#16a34a",
              "content": "2. Calibration auto-extracted",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "VZ5tS",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "No per-sensor Cal XML picker. Calibration comes from the <sensor><calibration> block in cameras.xml.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "itBe3",
          "name": "c3",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "n26Q5",
              "fill": "#16a34a",
              "content": "3. Sensor label from XML",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "gZpkm",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Display the sensor label from the XML (from EXIF). No more 'Body' concept with prefix-derived names.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "gRA0I",
          "name": "c4",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "XIZNp",
              "fill": "#16a34a",
              "content": "4. Multi-directory support per sensor",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "WHrWk",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "[+] button adds image/mask directories. Handles the case where one Metashape sensor contains multiple physical lenses with images in separate folders. Files matched by stem against camera labels.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "c6zZQ",
          "name": "c5",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "O1Uyt",
              "fill": "#4ade80",
              "content": "5. Fisheye options: multi_pinhole + Re-evaluate",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "p04FeT",
              "fill": "#bbbbbb",
              "textGrowth": "fixed-width-height",
              "width": 366,
              "height": "fit_content(36)",
              "content": "Boolean checkbox per fisheye sensor. multi_pinhole=True splits into 5 cubefaces (Path A); =False uses adaptive single-pinhole (Path B). GUI initializes it from routing's recommendation; a top-right ↻ Re-evaluate re-runs routing and resets the checkbox. The grey (theta_max=…°) helper next to the label shows lens info.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "li6N1",
          "name": "c6",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "Ygdsr",
              "fill": "#16a34a",
              "content": "6. Width = 0 auto-compute",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "NM0PW",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Width of 0 means: compute optimal output dimensions from the solid angle of the useful pixel region. Formula: width = 2 * sqrt(1 / max_solid_angle).",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "VEZvC",
          "name": "c7",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "x1LSc8",
              "fill": "#16a34a",
              "content": "7. Frame sensors get optional mask picker",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "q9gqt9",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "User-supplied masks (sky removal, object removal). Distortion validity masks still auto-generated by exporter and composited.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "Rr5K6",
          "name": "c8",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "DSez8",
              "fill": "#16a34a",
              "content": "8. Equirectangular → cubemap splitting",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "qvQ1C",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "New processing path. Equirect images split to cubeface pinholes with configurable width. Precedent code exists.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "X5J1v",
          "name": "c9",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "uGYWB",
              "fill": "#16a34a",
              "content": "9. Lens-only mask is a file, not a directory",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "bold"
            },
            {
              "type": "text",
              "id": "PghPs",
              "fill": "#cccccc",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "When checked, shows a file picker for a single mask image that defines the valid fisheye circle. Applies to all images in the sensor. Same concept as the Metashape alignment tab.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
